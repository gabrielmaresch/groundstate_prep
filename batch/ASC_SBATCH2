#!/bin/bash
#SBATCH --job-name=logs/h_sweep_N6_test
#SBATCH --output=logs/h_sweep_N6_test_%j.out
#SBATCH --error=logs/h_sweep_N6_test_%j.err

#SBATCH --partition=zen3_0512
#SBATCH --qos=zen3_0512
#SBATCH --time=01:00:00



#SBATCH --array=1-4%2
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem-per-cpu=16G

module purge
module load miniforge3



# print some information
echo "=== FIRST PATH CHECK ==="
echo "$PATH" | tr ':' '\n'

# activate conda
source "$(conda info --base)/etc/profile.d/conda.sh"
conda activate cooling

# load julia
#module load julia/1.10.9-gcc-12.2.0-ajiw47t
#which julia
#julia --version

# print some more information
# echo "=== SECOND PATH CHECK ==="
# echo "$PATH" | tr ':' '\n'

# print even more information
# echo "=== Diagnostics ==="
# echo "HOSTNAME: $(hostname)"
