# echo "=== EXECUTE PYTHON ==="
# which python

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

cd /home/fs71925/gmaresch/groundstate_prep

echo "PWD=$(pwd)"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}"

DATA_DIR=/gpfs/data/fs71925/gmaresch/data

#JULIA_DEPOT="$DATA_DIR/julia_depot:"
#export JULIA_DEPOT_PATH="$JULIA_DEPOT"
#echo "=== JULIA DEPOT ==="
#echo "JULIA_DEPOT_PATH=$JULIA_DEPOT_PATH"

alpha=$(awk -v tid="$SLURM_ARRAY_TASK_ID" 'BEGIN { printf "%.6f", 0.25 * tid }')

"$CONDA_PREFIX/bin/python" parallel_h_sweep.py \
  --N 6 \
  --T 25 \
  --alpha "$alpha" \
  --sigma 2.0 \
  --omega_max 2.5 \
  --tau 0.1 \
  --J 1.0 \
  --beta 1.0 \
  --h-values 0.4 1.0 1.6 \
  --normalize_Jh \
  --save-classical-populations \
  --skip-iterations \
  --data-dir "$DATA_DIR" \
  --workers "${SLURM_CPUS_PER_TASK}" \
  --save-as-nr "$SLURM_ARRAY_TASK_ID"
