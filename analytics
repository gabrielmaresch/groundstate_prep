def nice_print_matrix(A, digits=3):
    A = np.asarray(A)
    fmt = f"{{:.{digits}f}}"
    for row in A:
        print("  ".join(fmt.format(x) for x in row))

def trace_distace(A,B):
    lambdas = np.linalg.eigvalsh(A-B)
    dist = 1/2*sum(abs(ev) for ev in lambdas)
    return dist

