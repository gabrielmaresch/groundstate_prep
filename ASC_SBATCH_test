#!/bin/bash
#SBATCH --job-name=h_sweep_N4_test
#SBATCH --output=h_sweep_N4_test_%j.out
#SBATCH --error=h_sweep_N4_test_%j.err

#SBATCH --partition=zen3_0512
#SBATCH --qos=zen3_0512
#SBATCH --account=fs71925

# Devel-QoS variant for very short tests:
##SBATCH --qos=zen3_0512_devel
##SBATCH --time=00:10:00

#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=4
#SBATCH --mem=8G
#SBATCH --time=00:30:00

module purge
module load miniforge3
eval "$(conda shell.bash hook)"
conda activate cooling

export OMP_NUM_THREADS=1
export OPENBLAS_NUM_THREADS=1
export MKL_NUM_THREADS=1
export NUMEXPR_NUM_THREADS=1
export VECLIB_MAXIMUM_THREADS=1

cd /gpfs/data/fs71925/gmaresch/groundstate_prep

echo "PWD=$(pwd)"
echo "SLURM_CPUS_PER_TASK=${SLURM_CPUS_PER_TASK}"

python parallel_h_sweep.py \
  --N 4 \
  --T 25.0 \
  --alpha 0.75 \
  --sigma 2.0 \
  --omega_max 20 \
  --tau 0.1 \
  --J 1.0 \
  --beta 1.0 \
  --eps_fit 0.05 \
  --h_min 0.1 \
  --h_max 2.0 \
  --h_points 4 \
  --normalize_Jh \
  --workers "${SLURM_CPUS_PER_TASK}"